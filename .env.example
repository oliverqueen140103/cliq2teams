# --- Zoho (self-client) ---
# Create at https://api-console.zoho.in -> Self Client, with scopes:
#   ZohoCliq.Channels.READ ZohoCliq.Chats.READ ZohoCliq.Messages.READ
#   ZohoCliq.Attachments.READ ZohoCliq.Users.READ ZohoCliq.Buddies.READ
#   ZohoCliq.Profile.READ
# This token is per-person: it can only see YOUR chats and the channels you have
# joined. There is no org-wide endpoint, so every person runs the tool themselves.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Microsoft Entra ID (client credentials) ---
# MS_CLIENT_SECRET must be the secret *Value*, not the secret ID. Secrets expire;
# AADSTS7000215 on startup means it needs regenerating in the Azure portal.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
